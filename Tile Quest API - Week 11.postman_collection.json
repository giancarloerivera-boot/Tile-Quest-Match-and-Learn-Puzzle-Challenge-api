  "item": [
    {
      "name": "01 Create level works",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "   pm.test(\"status is 201\", function () {\r\n     pm.response.to.have.status(201);\r\n   });\r\n   pm.collectionVariables.set(\"setId\", pm.response.json().id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "   pm.collectionVariables.set(\"levelNumber\", Math.floor(Math.random() * 900) + 100);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "   { \"level_number\": {{levelNumber}}, \"difficulty\": \"Easy\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/levels",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "levels"
          ]
        }
      },
      "response": []
    },
